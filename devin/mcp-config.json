{
  "mcpServers": {
    "qscanner": {
      "command": "/home/ubuntu/cnapp-demo/.qscanner/qscanner",
      "args": ["mcp", "--pod", "CA1"],
      "env": {
        "QUALYS_ACCESS_TOKEN": "${QUALYS_ACCESS_TOKEN}",
        "QUALYS_IAC_AUTH_TYPE": "basic",
        "QUALYS_IAC_USERNAME": "${QUALYS_IAC_USERNAME}",
        "QUALYS_IAC_PASSWORD": "${QUALYS_IAC_PASSWORD}"
      }
    }
  }
}
